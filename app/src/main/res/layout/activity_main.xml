<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.otokit.noharayh.ui.shell.PageScene
        android:id="@+id/page_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 背景宿主：01 阶段为空，不设点击或焦点拦截。 -->
        <FrameLayout
            android:id="@+id/background_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 功能内容宿主：同一时刻最多一个活动的占位根 View。 -->
        <com.otokit.noharayh.ui.pages.GameSwipeLayout
            android:id="@+id/content_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 设置遮罩沿背景延伸到系统手势条背后。 -->
        <View
            android:id="@+id/settings_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@android:color/black"
            android:importantForAccessibility="no" />

        <!-- 设置滚动绘制面延伸到底边，内部安全留白约束滚动终点。 -->
        <FrameLayout
            android:id="@+id/overlay_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </com.otokit.noharayh.ui.shell.PageScene>

    <!-- 手机标题栏位于抽屉上方，宽屏导航栏位于内容区上方。 -->
    <FrameLayout
        android:id="@+id/chrome_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
