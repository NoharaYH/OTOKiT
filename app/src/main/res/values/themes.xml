<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 固定浅色：不跟随系统夜间模式。Material 控件使用局部主题。 -->
    <style name="Theme.OTOKiT" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- API 29 才有；低版本忽略，避免 lint 的 NewApi 误报整份主题。 -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
    <style name="Theme.OTOKiT.ColorSlider" parent="Theme.Material3.Light.NoActionBar">
        <item name="sliderStyle">@style/Widget.Material3.Slider</item>
    </style>
</resources>
